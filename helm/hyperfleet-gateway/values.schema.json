{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "HyperFleet Gateway values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gatewayClassName": { "type": "string", "minLength": 1 },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listeners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "port", "protocol"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "protocol": { "type": "string", "enum": ["HTTP", "HTTPS"] },
              "hostname": { "type": "string" },
              "tls": { "type": "object" },
              "authenticated": { "type": "boolean" }
            }
          }
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "tlsSecretName": { "type": "string" }
      }
    },
    "envoyProxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" },
        "logLevel": { "type": "string", "enum": ["trace", "debug", "info", "warn", "error", "critical", "off"] },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "LoadBalancer", "NodePort"] },
            "annotations": { "type": "object" }
          }
        }
      }
    },
    "headers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stripOverride": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } }
      }
    },
    "traffic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "triggers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "5xx",
                  "gateway-error",
                  "reset",
                  "reset-before-request",
                  "connect-failure",
                  "retriable-4xx",
                  "refused-stream",
                  "retriable-status-codes",
                  "cancelled",
                  "deadline-exceeded",
                  "internal",
                  "resource-exhausted",
                  "unavailable"
                ]
              }
            }
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "podMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    },
    "certificateWaiter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "minLength": 1 }
          }
        },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" }
      }
    },
    "authorino": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "image": { "type": "string" },
        "logLevel": { "type": "string", "minLength": 1 },
        "hosts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "authConfigLabelSelectors": { "type": "string" },
        "mockIssuerCASecretName": { "type": "string" },
        "wristbandHookImage": { "type": "string", "minLength": 1 },
        "policy": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "identityProviders": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "issuerUrl", "audience"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "issuerUrl": { "type": "string", "minLength": 1 },
                  "allowInsecureIssuer": { "type": "boolean" },
                  "audience": { "type": "string", "minLength": 1 },
                  "identityClaim": { "type": "string", "minLength": 1 },
                  "identityClaimPattern": { "type": "string" }
                },
                "allOf": [
                  {
                    "if": {
                      "required": ["allowInsecureIssuer"],
                      "properties": { "allowInsecureIssuer": { "const": true } }
                    },
                    "then": { "properties": { "issuerUrl": { "pattern": "^https?://[^[:space:]]+$" } } },
                    "else": { "properties": { "issuerUrl": { "pattern": "^https://[^[:space:]]+$" } } }
                  }
                ]
              }
            },
            "machineIdentity": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "audience": { "type": "string", "minLength": 1 },
                "allowedServiceAccounts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
              }
            },
            "tenant": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "model": { "type": "string", "enum": ["onprem", "oracle"] } }
            },
            "wristband": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "audience": { "type": "string", "minLength": 1 },
                "signingKeySecretName": { "type": "string", "minLength": 1 },
                "signingKeys": {
                  "type": "array",
                  "items": { "type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true }, "policy": { "type": "object" } },
            "required": ["enabled", "policy"]
          },
          "then": {
            "properties": {
              "policy": {
                "required": ["identityProviders", "machineIdentity"],
                "properties": {
                  "identityProviders": { "minItems": 1 },
                  "machineIdentity": {
                    "required": ["audience", "allowedServiceAccounts"],
                    "properties": { "allowedServiceAccounts": { "minItems": 1 } }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
