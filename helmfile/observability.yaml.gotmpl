# Observability stack configuration
# Components: kube-prometheus-stack, Tempo, OpenTelemetry Collector

helmDefaults:
  createNamespace: true
  wait: true
  timeout: 600
  cleanupOnFail: true

values:
  - monitoringNamespace: {{ env "MONITORING_NAMESPACE" | default "monitoring" }}

environments:
  e2e-gcp:
    values: []
  e2e-kind:
    values: []
  kind:
    values: []
  gcp:
    values: []

commonLabels:
  group: observability

repositories:
  - name: open-telemetry
    url: https://open-telemetry.github.io/opentelemetry-helm-charts

---

# validation is disabled on install because of helm diff trying to fetch CRDs which do not exist at the time
releases:
  - name: kube-prometheus-stack
    namespace: {{ .Values.monitoringNamespace }}
    chart: oci://ghcr.io/prometheus-community/charts/kube-prometheus-stack
    version: 87.18.0
    disableValidationOnInstall: true
    labels:
      component: kube-prometheus-stack
    values:
      - values/base-kube-prometheus-stack.yaml.gotmpl

  - name: tempo
    namespace: {{ .Values.monitoringNamespace }}
    chart: oci://ghcr.io/grafana-community/helm-charts/tempo
    version: 2.2.3
    labels:
      component: tempo
    values:
      - values/base-tempo.yaml.gotmpl

  - name: otel-collector
    namespace: {{ .Values.monitoringNamespace }}
    chart: open-telemetry/opentelemetry-collector
    version: 0.166.0
    needs:
      - tempo
    labels:
      component: otel-collector
    values:
      - values/base-otel-collector.yaml.gotmpl
