{{- $globalAuthMode := env "AUTH_MODE" | default "NONE" -}}
{{- $globalOIDCIssuerMode := env "OIDC_ISSUER_MODE" | default "external" -}}
# Helmfile configuration
# Documentation: https://helmfile.readthedocs.io/

{{ if and (has $globalAuthMode (list "EDGE" "API" "EDGE+API")) (eq $globalOIDCIssuerMode "mock") }}
hooks:
  - events: ["prepare"]
    showlogs: true
    command: "sh"
    args:
      - "-c"
      - |
        printf '%s\n' '' \
          'WARNING: DEVELOPMENT-ONLY mock OIDC issuer enabled' \
          'Signing keys are ephemeral and in-memory; a mock issuer rollout invalidates previously minted tokens.' \
          'Do not use mock OIDC for production.' ''
{{ end }}

# Common Helm defaults applied to all releases
helmDefaults:
  createNamespace: true
  wait: true
  timeout: 300
  cleanupOnFail: true

# Base values for all environments
values:
  - values/production-entities.yaml
  # AUTH_MODE is the sole authentication-placement control.
  - authMode: {{ env "AUTH_MODE" | default "NONE" | quote }}
  - namespace: {{ requiredEnv "NAMESPACE" }}
  - chartOrg: {{ env "CHART_ORG" | default "openshift-hyperfleet" }}
  # API audience shared by human JWTs and adapter/sentinel ServiceAccount tokens.
  - apiAudience: hyperfleet-api
  # TokenReview audience shared by gateway AuthConfig and adapter/sentinel clients.
  - machineIdentityAudience: hyperfleet-api
  - additionalMachineServiceAccounts: []
  # The desire store: the redis release's Service and port in this namespace.
  # Remote adapters write to it and the applier reads it, so both always use
  # the same store.
  - desireStoreUrl: redis://redis:6379/0
  - charts:
      api:
        chartRef: {{ env "API_CHART_REF" | default "main" }}
      sentinel:
        chartRef: {{ env "SENTINEL_CHART_REF" | default "main" }}
      adapter:
        chartRef: {{ env "ADAPTER_CHART_REF" | default "main" }}
      applier:
        chartRef: {{ env "APPLIER_CHART_REF" | default "main" }}

# Environment configurations - e2e-gcp, e2e-kind, kind, gcp
environments:
  e2e-gcp:
    values:
      - projectId: {{ env "PROJECT_ID" | default "hcm-hyperfleet" }}
        brokerType: googlepubsub
        gatewayServiceType: {{ env "GATEWAY_SERVICE_TYPE" | default "LoadBalancer" }}
        runId: {{ env "RUN_ID" | quote }}
      - environments/e2e-authentication.yaml.gotmpl
      - environments/e2e/fixture-entities.yaml
      - environments/e2e-gcp/adapter-configs.yaml.gotmpl
      - environments/e2e-gcp/sentinel-configs.yaml
  e2e-kind:
    values:
      - brokerType: rabbitmq
        gatewayServiceType: {{ env "GATEWAY_SERVICE_TYPE" | default "ClusterIP" }}
        runId: {{ env "RUN_ID" | quote }}
      - environments/e2e-authentication.yaml.gotmpl
      - environments/e2e/fixture-entities.yaml
      - environments/e2e-kind/adapter-configs.yaml.gotmpl
      - environments/e2e-kind/sentinel-configs.yaml
  kind:
    values:
      - brokerType: rabbitmq
        gatewayServiceType: {{ env "GATEWAY_SERVICE_TYPE" | default "ClusterIP" }}
      - environments/kind/adapter-configs.yaml.gotmpl
      - environments/kind/sentinel-configs.yaml.gotmpl
  gcp:
    values:
      - projectId: {{ env "PROJECT_ID" | default "hcm-hyperfleet" }}
        brokerType: googlepubsub
        gatewayServiceType: {{ env "GATEWAY_SERVICE_TYPE" | default "LoadBalancer" }}
      - environments/gcp/adapter-configs.yaml.gotmpl
      - environments/gcp/sentinel-configs.yaml.gotmpl

commonLabels:
  group: hyperfleet

---

{{- if and (.Values | get "fixtureEntities" (list)) (not (has .Environment.Name (list "e2e-kind" "e2e-gcp"))) }}
{{ fail "fixtureEntities are only allowed in e2e-kind and e2e-gcp" }}
{{- end }}

{{ if not (has .Values.authMode (list "NONE" "EDGE" "API" "EDGE+API")) }}
{{ fail "AUTH_MODE must be NONE, EDGE, API, or EDGE+API" }}
{{ end }}
{{- $edgeAuth := has .Values.authMode (list "EDGE" "EDGE+API") -}}
{{- $e2eEnvironment := has .Environment.Name (list "e2e-kind" "e2e-gcp") -}}
{{- $oidcAuth := has .Values.authMode (list "EDGE" "API" "EDGE+API") -}}
{{- $oidcIssuerMode := env "OIDC_ISSUER_MODE" | default "external" -}}
{{- if not (has $oidcIssuerMode (list "mock" "external")) }}
{{ fail "OIDC_ISSUER_MODE must be mock or external" }}
{{- end }}
{{- if and $oidcAuth (eq $oidcIssuerMode "mock") (not (has .Environment.Name (list "gcp" "kind" "e2e-kind" "e2e-gcp"))) }}
{{ fail "OIDC_ISSUER_MODE=mock is test-only and allowed only in gcp, kind, e2e-kind, or e2e-gcp" }}
{{- end }}
{{- if and $oidcAuth (eq $oidcIssuerMode "mock") (env "OIDC_ISSUER_URL") }}
{{ fail "OIDC_ISSUER_URL must be empty with OIDC_ISSUER_MODE=mock in authenticated modes" }}
{{- end }}
{{- if and $edgeAuth (eq $oidcIssuerMode "external") (not (regexMatch "^https://[^[:space:]]+$" (env "OIDC_ISSUER_URL"))) }}
{{ fail "OIDC_ISSUER_URL must be a non-empty https:// URL with OIDC_ISSUER_MODE=external in edge modes" }}
{{- end }}
{{- if and (env "OIDC_JWKS_URL") (not (env "OIDC_ISSUER_URL")) }}
{{ fail "OIDC_JWKS_URL is set without OIDC_ISSUER_URL" }}
{{- end }}
{{- if and (env "OIDC_ISSUER_URL") (not (regexMatch "^https://[^[:space:]]+$" (env "OIDC_ISSUER_URL"))) }}
{{ fail "OIDC_ISSUER_URL must be an https:// URL" }}
{{- end }}
{{- if and (env "OIDC_JWKS_URL") (not (regexMatch "^https://[^[:space:]]+$" (env "OIDC_JWKS_URL"))) }}
{{ fail "OIDC_JWKS_URL must be an https:// URL" }}
{{- end }}
{{- $tenantIsolationEnabled := eq (env "TENANT_ISOLATION_ENABLED" | default "false") "true" -}}
{{- if and $tenantIsolationEnabled (not $edgeAuth) }}
{{ fail "TENANT_ISOLATION_ENABLED=true requires AUTH_MODE=EDGE or EDGE+API" }}
{{- end }}
{{- $tenantModel := env "TENANT_MODEL" | default "onprem" -}}
{{- if and (or $edgeAuth $tenantIsolationEnabled) (not (has $tenantModel (list "onprem" "oracle"))) }}
{{ fail "TENANT_MODEL must be onprem or oracle when edge auth or tenant isolation is enabled" }}
{{- end }}
repositories:
  - name: hyperfleet-api
    url: git+https://github.com/{{ .Values.chartOrg }}/hyperfleet-api@charts?ref={{ .Values.charts.api.chartRef }}&sparse=0
  - name: hyperfleet-sentinel
    url: git+https://github.com/{{ .Values.chartOrg }}/hyperfleet-sentinel@charts?ref={{ .Values.charts.sentinel.chartRef }}&sparse=0
  - name: hyperfleet-adapter
    url: git+https://github.com/{{ .Values.chartOrg }}/hyperfleet-adapter@charts?ref={{ .Values.charts.adapter.chartRef }}&sparse=0
  - name: hyperfleet-applier
    url: git+https://github.com/{{ .Values.chartOrg }}/hyperfleet-applier@charts?ref={{ .Values.charts.applier.chartRef }}&sparse=0

releases:
  - name: external-dns
    namespace: {{ .Values.namespace }}
    chart: ../helm/external-dns
    installed: {{ eq (env "EXTERNAL_DNS_ENABLED" | default "false") "true" }}
    labels:
      component: external-dns
{{ if eq (env "EXTERNAL_DNS_ENABLED" | default "false") "true" }}
    values:
      - values/external-dns.yaml.gotmpl
{{ end }}
{{ if eq .Values.brokerType "rabbitmq" }}
  - name: rabbitmq
    namespace: {{ .Values.namespace }}
    chart: ../helm/rabbitmq
    labels:
      component: rabbitmq
{{ end }}

  # Development-only human issuer. Keep the release in Helmfile state when disabled so
  # an auth-mode change or teardown removes a previously deployed mock.
  - name: hyperfleet-mock-oidc
    namespace: {{ .Values.namespace }}
    chart: ../helm/mock-oidc
    installed: {{ and $oidcAuth (eq $oidcIssuerMode "mock") }}
    labels:
      component: mock-oidc
    values:
      - fullnameOverride: hyperfleet-mock-oidc
        tls:
          enabled: {{ and $oidcAuth (eq $oidcIssuerMode "mock") }}

  # Desire delivery: the Redis desire store and the applier that serves this
  # namespace's store partition.
  - name: redis
    namespace: {{ .Values.namespace }}
    chart: ../helm/redis
    labels:
      component: redis
    values:
      # Only the store's clients: the adapters marked desireStoreClient and the applier
      - networkPolicy:
          allowedClients:
{{- range .Values.adapters }}
{{- if and (hasKey . "desireStoreClient") .desireStoreClient }}
            - app.kubernetes.io/name: hyperfleet-adapter
              app.kubernetes.io/instance: {{ .name }}
{{- end }}
{{- end }}
            - app.kubernetes.io/name: hyperfleet-applier
              app.kubernetes.io/instance: hyperfleet-applier

  - name: hyperfleet-applier
    namespace: {{ .Values.namespace }}
    chart: hyperfleet-applier/hyperfleet-applier
    needs:
      - redis
    labels:
      component: applier
    values:
      - values/base-applier.yaml.gotmpl

  # HyperFleet API
  - name: hyperfleet-api
    namespace: {{ .Values.namespace }}
    chart: hyperfleet-api/hyperfleet-api
    # The gateway owns the internal PKI and (in EDGE+API) Authorino wristband
    # discovery plus the in-cluster signing-key lifecycle hook.
    # It must exist before the API mounts its serving certificate and CA bundle.
    needs:
      - hyperfleet-gateway
{{ if and (eq .Values.authMode "API") (eq $oidcIssuerMode "mock") }}
      - hyperfleet-mock-oidc
{{ end }}
    labels:
      component: api
    values:
      - values/base-api.yaml.gotmpl

  - name: hyperfleet-e2e
    namespace: {{ .Values.namespace }}
    chart: ../helm/hyperfleet-e2e
    installed: {{ $e2eEnvironment }}
    labels:
      component: e2e
    values:
      - serviceAccount:
          create: {{ $e2eEnvironment }}
          name: "hyperfleet-e2e-runner"

  - name: hyperfleet-gateway
    namespace: {{ .Values.namespace }}
    chart: ../helm/hyperfleet-gateway
{{ if or $e2eEnvironment (and $edgeAuth (eq $oidcIssuerMode "mock")) }}
    needs:
{{- if $e2eEnvironment }}
      - hyperfleet-e2e
{{- end }}
{{- if and $edgeAuth (eq $oidcIssuerMode "mock") }}
      - hyperfleet-mock-oidc
{{ end }}
{{ end }}
    labels:
      component: gateway
    values:
      - values/base-gateway.yaml.gotmpl

  - name: network-policies
    namespace: {{ .Values.namespace }}
    chart: ../helm/network-policies
    needs:
      - hyperfleet-api
      - hyperfleet-gateway
    labels:
      component: network-policies
    values:
      - values/base-network-policies.yaml.gotmpl

{{ range .Values.sentinels }}
  - name: {{ .name }}
    namespace: {{ $.Values.namespace }}
    chart: hyperfleet-sentinel/hyperfleet-sentinel
    needs:
      - hyperfleet-api
      - hyperfleet-gateway
    labels:
      component: sentinel
    values:
      - ./values/base-sentinel.yaml.gotmpl
{{ if hasKey . "values" }}
{{ toYaml .values | indent 6 }}
{{ end }}
{{ if hasKey . "setFiles" }}
    set:
{{ toYaml .setFiles | indent 6 }}
{{ end }}
{{ end }}

{{ range .Values.adapters }}
  - name: {{ .name }}
    namespace: {{ $.Values.namespace }}
    chart: hyperfleet-adapter/hyperfleet-adapter
    needs:
      - hyperfleet-api
      - hyperfleet-gateway
{{- if and (hasKey . "desireStoreClient") .desireStoreClient }}
      - redis
{{- end }}
    labels:
      component: adapter
{{- if and (hasKey . "desireStoreClient") .desireStoreClient }}
      desire-store-client: "true"
{{- end }}
    values:
      - ./values/base-adapter.yaml.gotmpl
{{ if hasKey . "values" }}
{{ toYaml .values | indent 6 }}
{{ end }}
{{ if hasKey . "setFiles" }}
    set:
{{ toYaml .setFiles | indent 6 }}
{{ end }}
{{ end }}
