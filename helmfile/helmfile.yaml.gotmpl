# Helmfile configuration
# Documentation: https://helmfile.readthedocs.io/

# Common Helm defaults applied to all releases
helmDefaults:
  createNamespace: true
  wait: true
  timeout: 300
  cleanupOnFail: true

# Base values for all environments
values:
  # AUTH_MODE is the sole authentication-placement control.
  - authMode: {{ env "AUTH_MODE" | default "NONE" | quote }}
  - namespace: {{ requiredEnv "NAMESPACE" }}
  - chartOrg: {{ env "CHART_ORG" | default "openshift-hyperfleet" }}
  # TokenReview audience shared by gateway AuthConfig and adapter/sentinel clients.
  - machineIdentityAudience: hyperfleet-api
  - charts:
      api:
        chartRef: {{ env "API_CHART_REF" | default "main" }}
      sentinel:
        chartRef: {{ env "SENTINEL_CHART_REF" | default "main" }}
      adapter:
        chartRef: {{ env "ADAPTER_CHART_REF" | default "main" }}

# Environment configurations - e2e, e2e-kind, kind, gcp
environments:
  e2e-gcp:
    values:
      - projectId: {{ env "PROJECT_ID" | default "hcm-hyperfleet" }}
        brokerType: googlepubsub
        gatewayServiceType: {{ env "GATEWAY_SERVICE_TYPE" | default "LoadBalancer" }}
        runId: {{ env "RUN_ID" | quote }}
      - environments/e2e-gcp/adapter-configs.yaml.gotmpl
      - environments/e2e-gcp/sentinel-configs.yaml
  e2e-kind:
    values:
      - brokerType: rabbitmq
        gatewayServiceType: {{ env "GATEWAY_SERVICE_TYPE" | default "ClusterIP" }}
        runId: {{ env "RUN_ID" | quote }}
      - environments/e2e-kind/adapter-configs.yaml.gotmpl
      - environments/e2e-kind/sentinel-configs.yaml
  kind:
    values:
      - brokerType: rabbitmq
        gatewayServiceType: {{ env "GATEWAY_SERVICE_TYPE" | default "ClusterIP" }}
      - environments/kind/adapter-configs.yaml.gotmpl
      - environments/kind/sentinel-configs.yaml.gotmpl
  gcp:
    values:
      - projectId: {{ env "PROJECT_ID" | default "hcm-hyperfleet" }}
        brokerType: googlepubsub
        gatewayServiceType: {{ env "GATEWAY_SERVICE_TYPE" | default "LoadBalancer" }}
      - environments/gcp/adapter-configs.yaml.gotmpl
      - environments/gcp/sentinel-configs.yaml.gotmpl

commonLabels:
  group: hyperfleet

---

{{ if not (has .Values.authMode (list "NONE" "EDGE" "API" "EDGE+API")) }}
{{ fail "AUTH_MODE must be NONE, EDGE, API, or EDGE+API" }}
{{ end }}
{{- $edgeAuth := has .Values.authMode (list "EDGE" "EDGE+API") -}}
{{- $oidcIssuerMode := env "OIDC_ISSUER_MODE" | default "external" -}}
{{- if not (has $oidcIssuerMode (list "mock" "external")) }}
{{ fail "OIDC_ISSUER_MODE must be mock or external" }}
{{- end }}
{{- if and $edgeAuth (eq $oidcIssuerMode "mock") (not (has .Environment.Name (list "kind" "e2e-kind" "e2e-gcp"))) }}
{{ fail "OIDC_ISSUER_MODE=mock is test-only and allowed only in kind, e2e-kind, or e2e-gcp" }}
{{- end }}
{{- if and $edgeAuth (eq $oidcIssuerMode "mock") (env "OIDC_ISSUER_URL") }}
{{ fail "OIDC_ISSUER_URL must be empty with OIDC_ISSUER_MODE=mock in edge modes" }}
{{- end }}
{{- if and $edgeAuth (eq $oidcIssuerMode "external") (not (regexMatch "^https://[^[:space:]]+$" (env "OIDC_ISSUER_URL"))) }}
{{ fail "OIDC_ISSUER_URL must be a non-empty https:// URL with OIDC_ISSUER_MODE=external in edge modes" }}
{{- end }}
repositories:
  - name: hyperfleet-api
    url: git+https://github.com/{{ .Values.chartOrg }}/hyperfleet-api@charts?ref={{ .Values.charts.api.chartRef }}&sparse=0
  - name: hyperfleet-sentinel
    url: git+https://github.com/{{ .Values.chartOrg }}/hyperfleet-sentinel@charts?ref={{ .Values.charts.sentinel.chartRef }}&sparse=0
  - name: hyperfleet-adapter
    url: git+https://github.com/{{ .Values.chartOrg }}/hyperfleet-adapter@charts?ref={{ .Values.charts.adapter.chartRef }}&sparse=0

releases:
  - name: external-dns
    namespace: {{ .Values.namespace }}
    chart: ../helm/external-dns
    installed: {{ eq (env "EXTERNAL_DNS_ENABLED" | default "false") "true" }}
    labels:
      component: external-dns
{{ if eq (env "EXTERNAL_DNS_ENABLED" | default "false") "true" }}
    values:
      - values/external-dns.yaml.gotmpl
{{ end }}
{{ if eq .Values.brokerType "rabbitmq" }}
  - name: rabbitmq
    namespace: {{ .Values.namespace }}
    chart: ../helm/rabbitmq
    labels:
      component: rabbitmq
{{ end }}

  # Test-only human issuer. Keep the release in Helmfile state when disabled so
  # an auth-mode change or teardown removes a previously deployed mock.
  - name: hyperfleet-mock-oidc
    namespace: {{ .Values.namespace }}
    chart: ../helm/mock-oidc
    installed: {{ and $edgeAuth (eq $oidcIssuerMode "mock") }}
    labels:
      component: mock-oidc
    values:
      - fullnameOverride: hyperfleet-mock-oidc

  # HyperFleet API
  - name: hyperfleet-api
    namespace: {{ .Values.namespace }}
    chart: hyperfleet-api/hyperfleet-api
    # The gateway owns the internal PKI and (in EDGE+API) wristband discovery.
    # It must exist before the API mounts its serving certificate and CA bundle.
    needs:
      - hyperfleet-gateway
    labels:
      component: api
    values:
      - values/base-api.yaml.gotmpl

  - name: hyperfleet-gateway
    namespace: {{ .Values.namespace }}
    chart: ../helm/hyperfleet-gateway
{{ if and $edgeAuth (eq $oidcIssuerMode "mock") }}
    needs:
      - hyperfleet-mock-oidc
{{ end }}
    labels:
      component: gateway
    values:
      - values/base-gateway.yaml.gotmpl

  - name: network-policies
    namespace: {{ .Values.namespace }}
    chart: ../helm/network-policies
    needs:
      - hyperfleet-api
      - hyperfleet-gateway
    labels:
      component: network-policies
    values:
      - values/base-network-policies.yaml.gotmpl

{{ range .Values.sentinels }}
  - name: {{ .name }}
    namespace: {{ $.Values.namespace }}
    chart: hyperfleet-sentinel/hyperfleet-sentinel
    needs:
      - hyperfleet-api
      - hyperfleet-gateway
    labels:
      component: sentinel
    values:
      - ./values/base-sentinel.yaml.gotmpl
{{ if hasKey . "values" }}
{{ toYaml .values | indent 6 }}
{{ end }}
{{ if hasKey . "setFiles" }}
    set:
{{ toYaml .setFiles | indent 6 }}
{{ end }}
{{ end }}

{{ range .Values.adapters }}
  - name: {{ .name }}
    namespace: {{ $.Values.namespace }}
    chart: hyperfleet-adapter/hyperfleet-adapter
    needs:
      - hyperfleet-api
      - hyperfleet-gateway
    labels:
      component: adapter
    values:
      - ./values/base-adapter.yaml.gotmpl
{{ if hasKey . "values" }}
{{ toYaml .values | indent 6 }}
{{ end }}
{{ if hasKey . "setFiles" }}
    set:
{{ toYaml .setFiles | indent 6 }}
{{ end }}
{{ end }}
