# Helmfile configuration
# Documentation: https://helmfile.readthedocs.io/

# Common Helm defaults applied to all releases
helmDefaults:
  createNamespace: true
  wait: true
  timeout: 300
  cleanupOnFail: true

# Base values for all environments
values:
  - namespace: {{ requiredEnv "NAMESPACE" }}
  - charts:
      api:
        version: {{ env "API_CHART_VERSION" | default "0.3.1" }}
      sentinel:
        version: {{ env "SENTINEL_CHART_VERSION" | default "0.3.1" }}
      adapter:
        version: {{ env "ADAPTER_CHART_VERSION" | default "0.3.1" }}

# Environment configurations - e2e, e2e-kind, kind, gcp
environments:
  e2e-gcp:
    values:
      - projectId: {{ env "PROJECT_ID" | default "hcm-hyperfleet" }}
        brokerType: googlepubsub
        serviceType: {{ env "API_SERVICE_TYPE" | default "LoadBalancer" }}
        runId: {{ env "RUN_ID" | quote }}
      - environments/e2e-gcp/adapter-configs.yaml.gotmpl
      - environments/e2e-gcp/sentinel-configs.yaml
  e2e-kind:
    values:
      - brokerType: rabbitmq
        serviceType: {{ env "API_SERVICE_TYPE" | default "ClusterIP" }}
        runId: {{ env "RUN_ID" | quote }}
      - environments/e2e-kind/adapter-configs.yaml.gotmpl
      - environments/e2e-kind/sentinel-configs.yaml
  kind:
    values:
      - brokerType: rabbitmq
        serviceType: {{ env "API_SERVICE_TYPE" | default "ClusterIP" }}
      - environments/kind/adapter-configs.yaml.gotmpl
      - environments/kind/sentinel-configs.yaml.gotmpl
  gcp:
    values:
      - projectId: {{ env "PROJECT_ID" | default "hcm-hyperfleet" }}
        brokerType: googlepubsub
        serviceType: {{ env "API_SERVICE_TYPE" | default "LoadBalancer" }}
      - environments/gcp/adapter-configs.yaml.gotmpl
      - environments/gcp/sentinel-configs.yaml.gotmpl

commonLabels:
  group: hyperfleet

---


releases:
{{ if eq .Values.brokerType "rabbitmq" }}
  - name: rabbitmq
    namespace: {{ .Values.namespace }}
    chart: ../helm/rabbitmq
    labels:
      component: rabbitmq
{{ end }}

  # HyperFleet API
  - name: hyperfleet-api
    namespace: {{ .Values.namespace }}
    chart: oci://quay.io/redhat-services-prod/hyperfleet-tenant/hyperfleet/hyperfleet-api-chart
    version: {{ .Values.charts.api.version }}
    labels:
      component: api
    values:
      - values/base-api.yaml.gotmpl

{{ range .Values.sentinels }}
  - name: {{ .name }}
    namespace: {{ $.Values.namespace }}
    chart: oci://quay.io/redhat-services-prod/hyperfleet-tenant/hyperfleet/hyperfleet-sentinel-chart
    version: {{ $.Values.charts.sentinel.version }}
    needs:
      - hyperfleet-api
    labels:
      component: sentinel
    values:
      - ./values/base-sentinel.yaml.gotmpl
{{ if hasKey . "values" }}
{{ toYaml .values | indent 6 }}
{{ end }}
{{ if hasKey . "setFiles" }}
    set:
{{ toYaml .setFiles | indent 6 }}
{{ end }}
{{ end }}

{{ range .Values.adapters }}
  - name: {{ .name }}
    namespace: {{ $.Values.namespace }}
    chart: oci://quay.io/redhat-services-prod/hyperfleet-tenant/hyperfleet/hyperfleet-adapter-chart
    version: {{ $.Values.charts.adapter.version }}
    labels:
      component: adapter
    values:
      - ./values/base-adapter.yaml.gotmpl
{{ if hasKey . "values" }}
{{ toYaml .values | indent 6 }}
{{ end }}
{{ if hasKey . "setFiles" }}
    set:
{{ toYaml .setFiles | indent 6 }}
{{ end }}
{{ end }}

