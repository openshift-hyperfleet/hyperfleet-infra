{{ $namespace := requiredEnv "NAMESPACE" }}
adapters:
  - name: cl-namespace
    resourceType: clusters
    values:
      - adapterTaskConfig:
          create: true
        adapterConfig:
          create: true
          log:
            level: debug
        rbac:
          resources:
            - namespaces
            - serviceaccounts
            - configmaps
            - deployments
            - roles
            - rolebindings
            - jobs
            - jobs/status
            - pods
        broker:
          create: true
          googlepubsub:
            subscriptionId: {{ $namespace }}-clusters-cl-namespace
            topic: {{ $namespace }}-clusters
            deadLetterTopic: {{ $namespace }}-clusters-dlq
    setFiles:
      - name: adapterConfig.yaml
        file: configs/e2e/adapters/cl-namespace/adapter-config.yaml
      - name: adapterTaskConfig.yaml
        file: configs/e2e/adapters/cl-namespace/adapter-task-config.yaml

  - name: cl-job
    resourceType: clusters
    values:
      - adapterTaskConfig:
          create: true
        adapterConfig:
          create: true
          log:
            level: debug
        rbac:
          resources:
            - namespaces
            - jobs
        broker:
          create: true
          googlepubsub:
            subscriptionId: {{ $namespace }}-clusters-cl-job
            topic: {{ $namespace }}-clusters
            deadLetterTopic: {{ $namespace }}-clusters-dlq
    setFiles:
      - name: adapterConfig.yaml
        file: configs/e2e/adapters/cl-job/adapter-config.yaml
      - name: adapterTaskConfig.external.task-config
        file: configs/e2e/adapters/cl-job/adapter-task-config.yaml
      - name: adapterTaskConfig.external.job
        file: configs/e2e/adapters/cl-job/adapter-task-resource-job.yaml
  
  - name: cl-deployment
    resourceType: clusters
    values:
      - adapterTaskConfig:
          create: true
        adapterConfig:
          create: true
          log:
            level: debug
        rbac:
          resources:
            - deployments
            - deployments/status
        broker:
          create: true
          googlepubsub:
            subscriptionId: {{ $namespace }}-clusters-cl-deployment
            topic: {{ $namespace }}-clusters
            deadLetterTopic: {{ $namespace }}-clusters-dlq
    setFiles:
      - name: adapterConfig.yaml
        file: configs/e2e/adapters/cl-deployment/adapter-config.yaml
      - name: adapterTaskConfig.external.task-config
        file: configs/e2e/adapters/cl-deployment/adapter-task-config.yaml
      - name: adapterTaskConfig.external.deployment
        file: configs/e2e/adapters/cl-deployment/adapter-task-resource-deployment.yaml
  
  # Remote adapter: delivers through the desire store and the applier
  - name: cl-desire
    resourceType: clusters
    desireStoreClient: true
    values:
      - ./values/remote-adapter.yaml.gotmpl
      - broker:
          create: true
          googlepubsub:
            subscriptionId: {{ $namespace }}-clusters-cl-desire
            topic: {{ $namespace }}-clusters
            deadLetterTopic: {{ $namespace }}-clusters-dlq

  - name: np-configmap
    resourceType: nodepools
    values:
      - adapterTaskConfig:
          create: true
        adapterConfig:
          create: true
          log:
            level: debug
        rbac:
          resources:
            - configmaps
            - configmaps/status
        broker:
          create: true
          googlepubsub:
            subscriptionId: {{ $namespace }}-nodepools-np-configmap
            topic: {{ $namespace }}-nodepools
            deadLetterTopic: {{ $namespace }}-nodepools-dlq
    setFiles:
      - name: adapterConfig.yaml
        file: configs/e2e/adapters/np-configmap/adapter-config.yaml
      - name: adapterTaskConfig.external.task-config
        file: configs/e2e/adapters/np-configmap/adapter-task-config.yaml
      - name: adapterTaskConfig.external.configmap
        file: configs/e2e/adapters/np-configmap/adapter-task-resource-configmap.yaml
  # Fixture success role. One shared task config serves both
  # adapter-backed fixture plurals; the resource URL comes from the event href,
  # so only the deployment config and the queue differ per release. The queue and
  # subscription are named {namespace}-{release} rather than the cluster
  # releases' {namespace}-{plural}-{release}, because the role name already
  # carries the plural and the longer form would repeat it.

  - name: parents-success
    resourceType: parents
    values:
      - adapterTaskConfig:
          create: true
        adapterConfig:
          create: true
          log:
            level: debug
        rbac:
          resources:
            - namespaces
        broker:
          create: true
          googlepubsub:
            subscriptionId: {{ $namespace }}-parents-success
            topic: {{ $namespace }}-parents
            deadLetterTopic: {{ $namespace }}-parents-dlq
    setFiles:
      - name: adapterConfig.yaml
        file: configs/e2e/adapters/parents-success/adapter-config.yaml
      - name: adapterTaskConfig.yaml
        file: configs/e2e/adapters/adapter-success/adapter-task-config.yaml

  - name: cascadechildren-success
    resourceType: cascadechildren
    values:
      - adapterTaskConfig:
          create: true
        adapterConfig:
          create: true
          log:
            level: debug
        rbac:
          resources:
            - namespaces
        broker:
          create: true
          googlepubsub:
            subscriptionId: {{ $namespace }}-cascadechildren-success
            topic: {{ $namespace }}-cascadechildren
            deadLetterTopic: {{ $namespace }}-cascadechildren-dlq
    setFiles:
      - name: adapterConfig.yaml
        file: configs/e2e/adapters/cascadechildren-success/adapter-config.yaml
      - name: adapterTaskConfig.yaml
        file: configs/e2e/adapters/adapter-success/adapter-task-config.yaml

