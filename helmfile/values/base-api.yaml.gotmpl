# Base values for HyperFleet API

{{ $obs := eq (env "OBSERVABILITY_ENABLED" | default "false") "true" }}
{{ $tracing := eq (env "TRACING_ENABLED" | default "false") "true" }}
{{ if or $obs $tracing }}
monitoring:
  {{ if $obs }}
  serviceMonitor:
    enabled: true
  prometheusRule:
    enabled: true
  dashboard:
    enabled: true
  {{ end }}
  {{ if $tracing }}
  tracing:
    enabled: true
    otlpEndpoint: "http://otel-collector.{{ env "MONITORING_NAMESPACE" | default "monitoring" }}.svc.cluster.local:4317"
  {{ end }}
{{ end }}

image:
  registry: {{ env "REGISTRY" | default "quay.io" }}
  repository: {{ env "API_REPOSITORY" | default "redhat-services-prod/hyperfleet-tenant/hyperfleet/hyperfleet-api" }}
  tag: {{ env "API_IMAGE_TAG" | default "dev" }}
  pullPolicy: {{ env "IMAGE_PULL_POLICY" | default "IfNotPresent" }}

service:
  # hyperfleet-gateway is the intended external entry point (see its own
  # gatewayServiceType wiring in helmfile.yaml.gotmpl) — hyperfleet-api itself
  # stays ClusterIP so it can't be reached directly, bypassing gateway header stripping.
  type: ClusterIP

config:
  entities:
    - kind: Cluster
      plural: clusters
      spec_schema_name: ClusterSpec
      required_adapters:
        {{- range .Values.adapters }}
        {{- if eq .resourceType "clusters" }}
        - {{ .name }}
        {{- end }}
        {{- end }}
      references:
        - ref_type: wif_config
          target_kind: WifConfig
          min: 0
          max: 1
      name_min_len: 3
      name_max_len: 53
      require_spec_schema: true
    - kind: NodePool
      plural: nodepools
      parent_kind: Cluster
      on_parent_delete: cascade
      spec_schema_name: NodePoolSpec
      required_adapters:
        {{- range .Values.adapters }}
        {{- if eq .resourceType "nodepools" }}
        - {{ .name }}
        {{- end }}
        {{- end }}
      name_min_len: 3
      name_max_len: 15
      require_spec_schema: true
    - kind: Channel
      plural: channels
      spec_schema_name: ChannelSpec
    - kind: Version
      plural: versions
      parent_kind: Channel
      on_parent_delete: restrict
      spec_schema_name: VersionSpec
    - kind: WifConfig
      plural: wifconfigs
      spec_schema_name: WifConfigSpec
  {{/*
    Auth boundary: when EXT_AUTHZ_ENABLED=true the gateway (Envoy + Authorino)
    is the authentication boundary - it validates human OIDC callers and injects
    trusted tenant headers, so in-app JWT stays OFF here (chart default).
    TODO(HYPERFLEET-1484): re-enable in-app JWT as defense-in-depth (its
    issuer/audience must match the gateway AuthConfig).

    Tenant enforcement: the API enforces gateway-injected tenant headers via
    config.server.tenant.dimensions, which must mirror the active tenantModel
    headers in helm/hyperfleet-gateway/values.yaml. Wire that block here once
    the API chart renders server.tenant (today it exposes only config.server.jwt).
    A model swap then moves both sides in lockstep with zero code change.
  */}}
  {{ if eq (env "JWT_AUTH_ENABLED" | default "false") "true" }}
  server:
    jwt:
      enabled: true
      configs:
      {{/* GCP OIDC when OIDC_ISSUER_URL is explicitly provided; K8s in-cluster OIDC otherwise */}}
      {{ if env "OIDC_ISSUER_URL" }}
        - issuer_url: "{{ env "OIDC_ISSUER_URL" }}"
          jwk_cert_url: "{{ env "OIDC_JWKS_URL" | default (printf "%s/jwks" (env "OIDC_ISSUER_URL")) }}"
          audience: hyperfleet-api
          identity_claim: sub
          identity_claim_pattern: "^system:serviceaccount:{{ env "NAMESPACE" | default "hyperfleet" }}:.*$"
        - issuer_url: https://accounts.google.com
          jwk_cert_url: https://www.googleapis.com/oauth2/v3/certs
          identity_claim: email
      {{ else }}
        - issuer_url: "https://kubernetes.default.svc.cluster.local"
          jwk_cert_url: "https://kubernetes.default.svc.cluster.local/openid/v1/jwks"
          jwk_cert_ca_file: "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
          header: "Authorization"
          audience: hyperfleet-api
          identity_claim: sub
          identity_claim_pattern: "^system:serviceaccount:{{ env "NAMESPACE" | default "hyperfleet-local" }}:.*$"
      {{ end }}
  {{ end }}
