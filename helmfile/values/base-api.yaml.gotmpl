# Base values for HyperFleet API

replicaCount: 2

{{ $obs := eq (env "OBSERVABILITY_ENABLED" | default "false") "true" }}
{{ $tracing := eq (env "TRACING_ENABLED" | default "false") "true" }}
{{ $authMode := .Values.authMode }}
{{ $apiAuthEnabled := has $authMode (list "API" "EDGE+API") }}
{{ $wristbandMode := eq $authMode "EDGE+API" }}
{{ $tenantIsolationEnabled := eq (env "TENANT_ISOLATION_ENABLED" | default "false") "true" }}
{{ $tenantModel := env "TENANT_MODEL" | default "onprem" }}
{{ $kubernetesOIDC := dict }}
{{ $mockOIDC := and (eq $authMode "API") (eq (env "OIDC_ISSUER_MODE" | default "external") "mock") }}
{{ $mockIssuer := printf "https://hyperfleet-mock-oidc.%s.svc.cluster.local:8443/default" .Release.Namespace }}
{{ $mockJWKS := printf "%s/jwks" $mockIssuer }}
{{ if eq $authMode "API" }}
{{/*
  Discover the selected cluster's public OIDC endpoints only for direct API
  authentication. The script also enables Kind's standard issuer-discovery
  ClusterRole for anonymous callers, matching GKE's public OIDC endpoints.
*/}}
{{ $kubernetesOIDC = (exec "../../scripts/discover-kubernetes-oidc.sh" (list .Release.Namespace) | fromYaml) }}
{{ end }}
{{ $wristbandIssuer := printf "https://authorino-authorino-oidc.%s.svc:8083/%s/hyperfleet-tenant-policy/wristband" .Release.Namespace .Release.Namespace }}
{{ $wristbandJWKS := printf "%s/.well-known/openid-connect/certs" $wristbandIssuer }}
{{ if or $obs $tracing }}
monitoring:
  {{ if $obs }}
  serviceMonitor:
    enabled: true
  prometheusRule:
    enabled: true
  dashboard:
    enabled: true
  {{ end }}
  {{ if $tracing }}
  tracing:
    enabled: true
    otlpEndpoint: "http://otel-collector.{{ env "MONITORING_NAMESPACE" | default "monitoring" }}.svc.cluster.local:4317"
  {{ end }}
{{ end }}

image:
  registry: {{ env "REGISTRY" | default "quay.io" }}
  repository: {{ env "API_REPOSITORY" | default "redhat-services-prod/hyperfleet-tenant/hyperfleet/hyperfleet-api" }}
  tag: {{ env "API_IMAGE_TAG" | default "dev" }}
  pullPolicy: {{ env "IMAGE_PULL_POLICY" | default "IfNotPresent" }}

service:
  # hyperfleet-gateway is the intended external entry point (see its own
  # gatewayServiceType wiring in helmfile.yaml.gotmpl) — hyperfleet-api itself
  # stays ClusterIP so it can't be reached directly, bypassing gateway header stripping.
  type: ClusterIP

extraVolumes:
  - name: api-tls
    secret:
      secretName: hyperfleet-api-server-cert
      items:
        - key: tls.crt
          path: tls.crt
        - key: tls.key
          path: tls.key
{{ if $wristbandMode }}
  - name: gateway-ca
    secret:
      secretName: hyperfleet-gateway-ca-cert
      items:
        - key: ca.crt
          path: ca.crt
{{ end }}
{{ if $mockOIDC }}
  - name: mock-oidc-ca
    secret:
      secretName: hyperfleet-mock-oidc-tls
      items:
        - key: tls.crt
          path: ca.crt
{{ end }}
extraVolumeMounts:
  - name: api-tls
    mountPath: /etc/hyperfleet/tls
    readOnly: true
{{ if $wristbandMode }}
  - name: gateway-ca
    mountPath: /etc/hyperfleet/gateway-ca
    readOnly: true
{{ end }}
{{ if $mockOIDC }}
  - name: mock-oidc-ca
    mountPath: /etc/hyperfleet/mock-oidc-ca
    readOnly: true
{{ end }}

{{/*
  required_adapters lists the adapters each environment deploys for a kind. An
  environment can deploy none for a kind, and the API chart schema rejects
  null, so render a list.
*/}}
{{- $clusterAdapters := list }}
{{- $nodePoolAdapters := list }}
{{- range .Values.adapters }}
{{- if eq .resourceType "clusters" }}
{{- $clusterAdapters = append $clusterAdapters .name }}
{{- else if eq .resourceType "nodepools" }}
{{- $nodePoolAdapters = append $nodePoolAdapters .name }}
{{- end }}
{{- end }}
config:
  entities:
    - kind: Cluster
      plural: clusters
      spec_schema_name: ClusterSpec
      required_adapters:
        {{- if $clusterAdapters }}
        {{- toYaml $clusterAdapters | nindent 8 }}
        {{- else }} []
        {{- end }}
      references:
        - ref_type: wif_config
          target_kind: WifConfig
          min: 0
          max: 1
      name_min_len: 3
      name_max_len: 53
      require_spec_schema: true
    - kind: NodePool
      plural: nodepools
      parent_kind: Cluster
      on_parent_delete: cascade
      spec_schema_name: NodePoolSpec
      required_adapters:
        {{- if $nodePoolAdapters }}
        {{- toYaml $nodePoolAdapters | nindent 8 }}
        {{- else }} []
        {{- end }}
      name_min_len: 3
      name_max_len: 15
      require_spec_schema: true
    - kind: Channel
      plural: channels
      spec_schema_name: ChannelSpec
    - kind: Version
      plural: versions
      parent_kind: Channel
      on_parent_delete: restrict
      spec_schema_name: VersionSpec
    - kind: WifConfig
      plural: wifconfigs
      spec_schema_name: WifConfigSpec
  {{/*
    EDGE authenticates exclusively at the gateway. API validates direct caller
    credentials in API mode, and validates only gateway-issued wristbands in
    EDGE+API mode. Tenant enforcement always consumes trusted gateway headers.
  */}}
  server:
    tls:
      enabled: true
      cert_file: /etc/hyperfleet/tls/tls.crt
      key_file: /etc/hyperfleet/tls/tls.key
    {{ if $tenantIsolationEnabled }}
    tenant:
      enabled: true
      system_header: x-hyperfleet-system
      dimensions:
      {{ if eq $tenantModel "onprem" }}
        - header: x-tenant-org
          key: org
          required: true
        - header: x-tenant-project
          key: project
          required: false
      {{ else if eq $tenantModel "oracle" }}
        - header: x-tenant-tenancy-ocid
          key: tenancy_ocid
          required: true
        - header: x-tenant-compartment
          key: compartment_id
          required: false
      {{ else }}
        {{ fail (printf "TENANT_MODEL %q is not supported (expected onprem or oracle)" $tenantModel) }}
      {{ end }}
    {{ end }}
    jwt:
      enabled: {{ $apiAuthEnabled }}
    {{ if $apiAuthEnabled }}
      configs:
      {{ if $wristbandMode }}
        # The gateway replaces the original credential with an Authorino
        # wristband, so raw human and ServiceAccount JWTs are not accepted here.
        - issuer_url: {{ $wristbandIssuer | quote }}
          jwk_cert_url: {{ $wristbandJWKS | quote }}
          jwk_cert_ca_file: /etc/hyperfleet/gateway-ca/ca.crt
          audience: hyperfleet-api
          identity_claim: sub
      {{ else }}
        # API mode validates ServiceAccount JWTs using the selected cluster's
        # publicly available OIDC discovery endpoint and advertised JWKS URL.
        - issuer_url: {{ index $kubernetesOIDC "issuer_url" | quote }}
          jwk_cert_url: {{ index $kubernetesOIDC "jwk_cert_url" | quote }}
          jwk_cert_ca_file: {{ index $kubernetesOIDC "jwk_cert_ca_file" | quote }}
          header: Authorization
          audience: hyperfleet-api
          identity_claim: sub
          identity_claim_pattern: {{ index $kubernetesOIDC "identity_claim_pattern" | quote }}
        {{ if $mockOIDC }}
        - issuer_url: {{ $mockIssuer | quote }}
          jwk_cert_url: {{ $mockJWKS | quote }}
          jwk_cert_ca_file: /etc/hyperfleet/mock-oidc-ca/ca.crt
          audience: hyperfleet-api
          identity_claim: email
        {{ else }}
        {{ if env "OIDC_ISSUER_URL" }}
        {{ if not (env "OIDC_JWKS_URL") }}
        {{ fail "OIDC_JWKS_URL is required when OIDC_ISSUER_URL is set for the human provider" }}
        {{ end }}
        # Optional human OIDC provider for direct API authentication.
        - issuer_url: {{ env "OIDC_ISSUER_URL" | quote }}
          jwk_cert_url: {{ env "OIDC_JWKS_URL" | quote }}
          audience: hyperfleet-api
          identity_claim: email
        {{ end }}
        {{ end }}
      {{ end }}
    {{ end }}
