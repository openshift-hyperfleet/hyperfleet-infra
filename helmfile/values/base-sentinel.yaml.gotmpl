# Base values for HyperFleet Sentinel

{{ if eq (env "OBSERVABILITY_ENABLED" | default "false") "true" }}
monitoring:
  serviceMonitor:
    enabled: true
  prometheusRule:
    enabled: true
{{ end }}

{{ if eq (env "TRACING_ENABLED" | default "false") "true" }}
tracing:
  enabled: true
  otlpEndpoint: "http://alloy.{{ env "MONITORING_NAMESPACE" | default "monitoring" }}.svc.cluster.local:4317"
{{ end }}

image:
  registry: {{ env "REGISTRY" | default "quay.io" }}
  repository: {{ env "SENTINEL_REPOSITORY" | default "redhat-services-prod/hyperfleet-tenant/hyperfleet/hyperfleet-sentinel" }}
  tag: {{ env "SENTINEL_IMAGE_TAG" | default "dev" }}
  pullPolicy: {{ env "IMAGE_PULL_POLICY" | default "IfNotPresent" }}

config:
  clients:
    hyperfleetApi:
      baseUrl: {{ env "API_BASE_URL" | default "http://hyperfleet-api:8000" }}
      {{ if eq (env "JWT_AUTH_ENABLED" | default "false") "true" }}
      auth:
        enabled: true
        audience: hyperfleet-api
      {{ end }}

broker:
  type: {{ .Values.brokerType }}
  {{ if eq .Values.brokerType "googlepubsub" }}
  googlepubsub:
    projectId: {{ .Values.projectId }}
    createTopicIfMissing: true
  {{ end }}
  {{ if eq .Values.brokerType "rabbitmq" }}
  rabbitmq:
    url: {{ env "RABBITMQ_URL" | default "amqp://guest:guest@rabbitmq:5672" }}
  {{ end }}
