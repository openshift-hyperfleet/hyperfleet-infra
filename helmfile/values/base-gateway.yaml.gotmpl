# Base values for HyperFleet Gateway

{{ if eq (env "OBSERVABILITY_ENABLED" | default "false") "true" }}
monitoring:
  serviceMonitor:
    enabled: true
{{ end }}

service:
  type: {{ .Values.gatewayServiceType }}

envoy:
  logging:
    level: {{ env "ENVOY_LOG_LEVEL" | default "info" }}

# Active tenant model for the rendered AuthConfig (onprem|oracle). Must stay in
# lockstep with config.server.tenant.dimensions in base-api values when wired.
tenant:
  model: {{ env "TENANT_MODEL" | default "onprem" }}

auth:
  # External authorization (Authorino). When enabled, Envoy authenticates every
  # request through Authorino and injects trusted tenant headers; the Authorino
  # instance and the active AuthConfig are deployed by the gateway chart too.
  extAuthz:
    enabled: {{ env "EXT_AUTHZ_ENABLED" | default "false" }}

  # OIDC issuer the human-jwt AuthConfig validates tokens against. Mock mode
  # derives an in-cluster URL and intentionally ignores stale generated GCP
  # values; external mode preserves the Terraform or CLI-supplied issuer.
  oidc:
    mode: {{ env "OIDC_ISSUER_MODE" | default "external" | quote }}
    issuerUrl: {{ if eq (env "OIDC_ISSUER_MODE" | default "external") "mock" }}{{ printf "http://hyperfleet-mock-oidc.%s.svc.cluster.local:8080/default" .Values.namespace | quote }}{{ else }}{{ env "OIDC_ISSUER_URL" | default "" | quote }}{{ end }}

  machineIdentity:
    audience: {{ .Values.machineIdentityAudience | quote }}
    # Exact SA allow-list, derived from the sentinels/adapters actually declared for
    # this environment (environments/<env>/{sentinel,adapter}-configs.yaml.gotmpl) so
    # it can't drift from the releases deployed. See helm/hyperfleet-gateway/values.yaml.
    allowedServiceAccounts:
      {{- range .Values.sentinels }}
      - {{ printf "%s-hyperfleet-sentinel" .name | quote }}
      {{- end }}
      {{- range .Values.adapters }}
      - {{ printf "%s-hyperfleet-adapter" .name | quote }}
      {{- end }}

  authorino:
    {{/*
      Authorino matches the AuthConfig against the request authority. The chart
      defaults to the in-cluster gateway Service DNS + localhost; set AUTHORINO_HOSTS
      (comma-separated) to add external hostnames (e.g. the gcp LoadBalancer host)
      so external callers are matched rather than denied by fail-closed host matching.
    */}}
    {{- if env "AUTHORINO_HOSTS" }}
    hosts:
      {{- range (env "AUTHORINO_HOSTS" | splitList ",") }}
      - {{ . | trim | quote }}
      {{- end }}
    {{- end }}
    logging:
      level: {{ env "AUTHORINO_LOG_LEVEL" | default "info" }}
